# =============================================================================
# .env.example — Copy this to .env and fill in your keys
# NEVER commit .env to version control.
# =============================================================================

# --- Groq API Key (Primary Provider: Qwen 2.5 / 3.8 27B & Llama 3.3 70B on LPU) ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Supabase PostgreSQL Configuration (Relational Data & Telemetry) ---
# Get from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# --- Optional: Google Gemini API Key ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional: OpenAI API Key ---
OPENAI_API_KEY=your_openai_api_key_here


